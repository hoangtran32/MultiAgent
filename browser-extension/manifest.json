{
  "manifest_version": 3,
  "name": "Multi-Agent Hub · Browser Chat",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "description": "Kết nối tab Gemini và ChatGPT đã đăng nhập với Multi-Agent Hub trên máy.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Kết nối chatbot với Hub"}
}
