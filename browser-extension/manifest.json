{
  "manifest_version": 3,
  "name": "Multi-Agent Hub · Browser Chat",
  "version": "1.3.0",
  "minimum_chrome_version": "114",
  "description": "Nhận diện tab chatbot và model, đọc phản hồi web cho Multi-Agent Hub bằng tài khoản trình duyệt.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Kết nối chatbot với Hub"}
}
